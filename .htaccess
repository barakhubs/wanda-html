Options -Indexes +FollowSymLinks

# ── Protect sensitive file types ──────────────────────────────────────────────

<FilesMatch "\.(env|sql|md|json|lock|xml|gitignore|log|sh|ini)$">
<IfModule mod_authz_core.c>
Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
Order Allow,Deny
Deny from all
</IfModule>
</FilesMatch>

# ── Routing ───────────────────────────────────────────────────────────────────

# All rewrite logic is in a single <IfModule> block so RewriteEngine On

# is guaranteed to apply to every rule below it.

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Block direct access to sensitive source directories
    RewriteRule ^(app|bootstrap|config|database|includes|routes|tests|vendor)(/|$) - [F,L]

    # Block dotfiles (except .well-known for SSL/ACME challenges)
    RewriteRule (^|/)\.(?!well-known) - [F,L]

    # Serve real static files that exist inside public/ (CSS, JS, images, uploads).
    # Exclude /index.php — that is a mod_dir DirectoryIndex artefact for the
    # domain root "/" and must fall through to the front-controller catch-all.
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f
    RewriteCond %{REQUEST_URI} !^/index\.php$ [NC]
    RewriteRule ^ public%{REQUEST_URI} [L]

    # Everything else goes to the front controller
    RewriteRule ^ public/index.php [L,QSA]

</IfModule>
