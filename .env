# Application Environment
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=wanda_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4
DB_PERSISTENT=false

# Session
SESSION_NAME=wanda_session

# Upload limits (bytes — 5 MB default)
MAX_UPLOAD_BYTES=5242880

# ── Mail (local dev override) ─────────────────────────────────────────────────
# Set MAIL_HOST to override the SMTP configured in Settings → Email & SMTP.
# Leave blank in production so the admin-panel SMTP settings are used instead.
# For local testing use Mailtrap: https://mailtrap.io → Inboxes → SMTP Settings
MAIL_HOST=
MAIL_PORT=2525
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
